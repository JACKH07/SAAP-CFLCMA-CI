# =============================================================================
# Variables Dokploy — copier dans l'onglet Environment
# =============================================================================

# --- MODE APPLICATION (1 conteneur, Dockerfile racine) ---
# Build : Dockerfile · Port : 4000 · Domaine → port 4000

DATABASE_URL=mysql://saap_prod:CHANGEZ_MOI@nom-du-service-mysql:3306/saap_cflcma_prod
APP_ENV=production
NODE_ENV=production
PORT=4000
SERVE_FRONTEND=true
JWT_SECRET=changez_moi_jwt_tres_long_et_aleatoire_production
CORS_ORIGIN=https://cfl.flambeauxcmaci.com
FRONTEND_URL=https://cfl.flambeauxcmaci.com
API_PUBLIC_URL=https://cfl.flambeauxcmaci.com/api

# --- MODE COMPOSE (docker-compose.dokploy.yml) ---
# Utilisez plutôt MYSQL_* ci-dessous ; DATABASE_URL est construite automatiquement.

MYSQL_ROOT_PASSWORD=changez_moi_root_fort
MYSQL_PASSWORD=changez_moi_saap_prod_fort
HTTP_PORT=3000

# --- Optionnel (les deux modes) ---
PAYMENT_MOCK_MODE=true
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@flccmaci.org
ADMIN_PASSWORD=AdminFLCCMACI2026!
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Systeme

# =============================================================================
# Trouver le host MySQL dans Dokploy
# =============================================================================
# 1. Créez un service MySQL dans le même projet
# 2. Host interne = nom du service (ex. saap-mysql ou l'ID Dokploy)
# 3. DATABASE_URL = mysql://USER:PASS@HOST:3306/NOM_BASE
#    Caractères spéciaux dans le mot de passe → encoder en URL (%40 pour @, etc.)
