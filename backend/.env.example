# =============================================================================
# Backend — développement local
# Copier vers .env : cp .env.example .env
# =============================================================================

APP_ENV=development
NODE_ENV=development

# Base de données MariaDB/MySQL (docker compose local → port 3310)
DATABASE_URL="mysql://saap:saap123@127.0.0.1:3310/saap_flccmaci"

# Serveur
PORT=4000

# --- Liens / URLs ---
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:5173

# Pages publiques (liens complets)
MEMBER_LOGIN_URL=http://localhost:5173/login
ADMIN_LOGIN_URL=http://localhost:5173/admin_connecte
REGISTER_URL=http://localhost:5173/register
ADMIN_DASHBOARD_URL=http://localhost:5173/admin
ADMIN_MEMBRES_URL=http://localhost:5173/admin/membres
ADMIN_COTISATIONS_URL=http://localhost:5173/admin/cotisations
ADMIN_BUREAU_URL=http://localhost:5173/admin/bureau
ADMIN_COMPTE_URL=http://localhost:5173/admin/compte
ADMIN_ACTIVITE_URL=http://localhost:5173/admin/activites
PROFIL_URL=http://localhost:5173/profil
MES_COTISATIONS_URL=http://localhost:5173/mes-cotisations

# JWT
JWT_SECRET=changez_moi_par_une_cle_secrete_longue_et_aleatoire
JWT_EXPIRES_IN=7d

# Réinitialisation mot de passe (sans SMTP : lien exposé en development)
PASSWORD_RESET_EXPOSE_LINK=true
PASSWORD_RESET_TTL_MS=3600000
RESET_PASSWORD_PATH=/reset-password

# Uploads justificatifs
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ---------------------------------------------------------------------------
# Paiements Mobile Money
# Mode mock : actif automatiquement sans credentials, ou forcé via PAYMENT_MOCK_MODE
# PAYMENT_MOCK_RESULT = success | pending | failed | timeout
# ---------------------------------------------------------------------------
PAYMENT_MOCK_MODE=true
PAYMENT_MOCK_RESULT=success

# Orange Money WebPay / E-commerce
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
ORANGE_MONEY_RETURN_URL=http://localhost:5173/mes-cotisations?paiement=ok
ORANGE_MONEY_CANCEL_URL=http://localhost:5173/mes-cotisations?paiement=annule
ORANGE_MONEY_NOTIF_URL=http://localhost:4000/api/cotisations/webhooks/orange
ORANGE_MONEY_CALLBACK_URL=http://localhost:4000/api/cotisations/webhooks/orange

# Wave Checkout
WAVE_API_URL=https://api.wave.com
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SUCCESS_URL=http://localhost:5173/mes-cotisations?paiement=ok
WAVE_ERROR_URL=http://localhost:5173/mes-cotisations?paiement=echec
WAVE_CALLBACK_URL=http://localhost:4000/api/cotisations/webhooks/wave

# MTN MoMo (prévu — non exposé dans l’UI pour l’instant)
MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=http://localhost:4000/api/cotisations/webhooks/mtn
MTN_MOMO_WEBHOOK_SECRET=

# Compte admin initial (seed)
ADMIN_EMAIL=admin@flccmaci.org
ADMIN_PASSWORD=AdminFLCCMACI2026!
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Systeme
