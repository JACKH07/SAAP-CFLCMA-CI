# =============================================================================
# Backend — PREPROD (staging)
# Copier : cp .env.preprod.example .env.preprod
# Usage : APP_ENV=preprod NODE_ENV=production npm run start:preprod
# Remplacer preprod.votredomaine.ci / api-preprod.votredomaine.ci par vos hôtes réels
# =============================================================================

APP_ENV=preprod
NODE_ENV=production

# Base de données preprod (séparée de la prod)
DATABASE_URL="mysql://saap_preprod:CHANGE_ME@127.0.0.1:3311/saap_cflcma_preprod"

PORT=4001

# --- Bases ---
FRONTEND_URL=https://preprod.votredomaine.ci
API_PUBLIC_URL=https://api-preprod.votredomaine.ci/api
CORS_ORIGIN=https://preprod.votredomaine.ci

# --- Liens absolus (toutes les pages) ---
MEMBER_LOGIN_URL=https://preprod.votredomaine.ci/login
ADMIN_LOGIN_URL=https://preprod.votredomaine.ci/admin_connecte
REGISTER_URL=https://preprod.votredomaine.ci/register
ADMIN_DASHBOARD_URL=https://preprod.votredomaine.ci/admin
ADMIN_MEMBRES_URL=https://preprod.votredomaine.ci/admin/membres
ADMIN_COTISATIONS_URL=https://preprod.votredomaine.ci/admin/cotisations
ADMIN_BUREAU_URL=https://preprod.votredomaine.ci/admin/bureau
ADMIN_COMPTE_URL=https://preprod.votredomaine.ci/admin/compte
ADMIN_ACTIVITE_URL=https://preprod.votredomaine.ci/admin/activites
PROFIL_URL=https://preprod.votredomaine.ci/profil
MES_COTISATIONS_URL=https://preprod.votredomaine.ci/mes-cotisations

# JWT — générer une clé longue et unique (différente de la prod)
JWT_SECRET=CHANGEZ_MOI_PREPROD_cle_secrete_longue_aleatoire
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Mobile Money — sandbox / test
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=https://api-preprod.votredomaine.ci/api/webhooks/mtn
MTN_MOMO_WEBHOOK_SECRET=

ADMIN_EMAIL=admin-preprod@cflcma-ci.org
ADMIN_PASSWORD=CHANGEZ_MOI_MotDePassePreprod!
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Preprod
