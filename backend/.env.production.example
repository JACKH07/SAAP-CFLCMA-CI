# =============================================================================
# Backend — PRODUCTION
# Copier vers .env.production puis renseigner les valeurs réelles
# Usage : APP_ENV=production NODE_ENV=production npm run start:production
# =============================================================================

APP_ENV=production
NODE_ENV=production

# Base de données production
DATABASE_URL="mysql://saap_prod:CHANGE_ME_FORT@127.0.0.1:3306/saap_cflcma_prod"

PORT=4000
CORS_ORIGIN=https://app.votredomaine.ci

# JWT — clé unique, longue, jamais partagée avec preprod/dev
JWT_SECRET=CHANGEZ_MOI_PRODUCTION_cle_secrete_tres_longue_et_aleatoire
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Mobile Money — production
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

MTN_MOMO_API_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=mtnivoire
MTN_MOMO_CALLBACK_URL=https://api.votredomaine.ci/api/webhooks/mtn
MTN_MOMO_WEBHOOK_SECRET=

ADMIN_EMAIL=admin@cflcma-ci.org
ADMIN_PASSWORD=CHANGEZ_MOI_MotDePasseProductionFort!
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Systeme
