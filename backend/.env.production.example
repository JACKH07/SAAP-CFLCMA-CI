# =============================================================================
# Backend — PRODUCTION
# Copier vers .env.production puis renseigner les valeurs réelles
# Usage : APP_ENV=production NODE_ENV=production npm run start:production
# =============================================================================

APP_ENV=production
NODE_ENV=production

# Base de données production
DATABASE_URL="mysql://saap_prod:CHANGE_ME_FORT@127.0.0.1:3306/saap_cflcma_prod"

PORT=4000

# --- Liens / URLs ---
FRONTEND_URL=https://app.votredomaine.ci
API_PUBLIC_URL=https://api.votredomaine.ci/api
CORS_ORIGIN=https://app.votredomaine.ci

MEMBER_LOGIN_URL=https://app.votredomaine.ci/login
ADMIN_LOGIN_URL=https://app.votredomaine.ci/admin_connecte
REGISTER_URL=https://app.votredomaine.ci/register
ADMIN_DASHBOARD_URL=https://app.votredomaine.ci/admin
ADMIN_MEMBRES_URL=https://app.votredomaine.ci/admin/membres
ADMIN_COTISATIONS_URL=https://app.votredomaine.ci/admin/cotisations
ADMIN_BUREAU_URL=https://app.votredomaine.ci/admin/bureau
ADMIN_COMPTE_URL=https://app.votredomaine.ci/admin/compte
ADMIN_ACTIVITE_URL=https://app.votredomaine.ci/admin/activites
PROFIL_URL=https://app.votredomaine.ci/profil
MES_COTISATIONS_URL=https://app.votredomaine.ci/mes-cotisations

# JWT — clé unique, longue, jamais partagée avec preprod/dev
JWT_SECRET=CHANGEZ_MOI_PRODUCTION_cle_secrete_tres_longue_et_aleatoire
