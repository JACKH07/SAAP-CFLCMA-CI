{
  "name": "saap-flccmaci-backend",
  "version": "1.0.0",
  "description": "API SAAP CFLCMA-CI — Système d'Administration et de Paiement",
  "main": "src/server.js",
  "scripts": {
    "dev": "APP_ENV=development NODE_ENV=development nodemon src/server.js",
    "start": "node src/server.js",
    "start:preprod": "APP_ENV=preprod NODE_ENV=production node src/server.js",
    "start:production": "APP_ENV=production NODE_ENV=production node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "node src/seed/seed.js",
    "seed:preprod": "APP_ENV=preprod NODE_ENV=production node src/seed/seed.js",
    "seed:production": "APP_ENV=production NODE_ENV=production node src/seed/seed.js",
    "admin:reset:production": "APP_ENV=production NODE_ENV=production node scripts/resetAdmin.js",
    "test": "jest --testPathPattern=src --forceExit"
  },
  "keywords": ["flccmaci", "saap"],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "5.22.0"
  }
}
