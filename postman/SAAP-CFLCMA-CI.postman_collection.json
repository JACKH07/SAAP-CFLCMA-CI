            "url": "{{baseUrl}}/api/activites"
          }
        },
        {
          "name": "GET Activités toutes (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/activites?all=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activites"],
              "query": [{ "key": "all", "value": "true" }]
            }
          }
        },
        {
          "name": "GET Activité by id (admin)",
          "request": {
            "method": "GET",
