              "mode": "raw",
              "raw": "{\n  \"montantDefaut\": 7500,\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/activites/{{activiteId}}"
          }
        }
      ]
    },
    {
      "name": "Cotisations",
      "item": [
        {
          "name": "GET Mes cotisations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/cotisations/me"
          }
        },
        {
          "name": "GET Liste cotisations (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cotisations?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cotisations"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "page", "value": "1" },
                { "key": "statut", "value": "", "disabled": true },
                { "key": "activite", "value": "", "disabled": true },
                { "key": "regionId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET Recherche id paiement (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/cotisations/search/{{idPaiement}}"
          }
        },
        {
          "name": "POST Paiement manuel (admin)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "modePaiement", "value": "MANUEL", "type": "text" },
                { "key": "membreId", "value": "{{membreId}}", "type": "text" },
                { "key": "activiteId", "value": "{{activiteId}}", "type": "text" },
                { "key": "montantPaye", "value": "5000", "type": "text" },
                { "key": "justificatif", "type": "file", "src": [], "description": "Optionnel" }
              ]
            },
            "url": "{{baseUrl}}/api/cotisations"
          }
        },
        {
          "name": "POST Initier Mobile Money",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"modePaiement\": \"MOBILE_MONEY\",\n  \"activiteId\": {{activiteId}},\n  \"provider\": \"ORANGE\",\n  \"phone\": \"0700000000\"\n}"
            },
            "url": "{{baseUrl}}/api/cotisations"
          }
        },
        {
          "name": "POST Webhook Orange",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPaiement\": \"{{idPaiement}}\",\n  \"status\": \"SUCCESS\",\n  \"amount\": 5000,\n  \"referenceExterne\": \"OM-TXN-001\"\n}"
            },
            "url": "{{baseUrl}}/api/cotisations/webhooks/orange"
          }
        },
        {
          "name": "POST Webhook MTN",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPaiement\": \"{{idPaiement}}\",\n  \"status\": \"SUCCESSFUL\",\n  \"amount\": 5000,\n  \"externalId\": \"MTN-TXN-001\"\n}"
            },
            "url": "{{baseUrl}}/api/cotisations/webhooks/mtn"
          }
        }
      ]
    },
