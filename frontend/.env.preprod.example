# Frontend — PREPROD
# Copier vers .env.preprod : cp .env.preprod.example .env.preprod
# Build : npm run build:preprod
# Remplacer preprod.votredomaine.ci / api-preprod.votredomaine.ci par vos hôtes réels

VITE_APP_ENV=preprod
VITE_APP_NAME=SAAP CFLCMA-CI (Preprod)

# --- Bases ---
VITE_APP_URL=https://preprod.votredomaine.ci
VITE_API_URL=https://api-preprod.votredomaine.ci/api

# --- Chemins (routes React) ---
VITE_LOGIN_PATH=/login
VITE_ADMIN_LOGIN_PATH=/admin_connecte
VITE_REGISTER_PATH=/register
VITE_ADMIN_PATH=/admin
VITE_ADMIN_MEMBRES_PATH=/admin/membres
VITE_ADMIN_COTISATIONS_PATH=/admin/cotisations
VITE_ADMIN_BUREAU_PATH=/admin/bureau
VITE_ADMIN_COMPTE_PATH=/admin/compte
VITE_ADMIN_ACTIVITE_PATH=/admin/activites
VITE_PROFIL_PATH=/profil
VITE_MES_COTISATIONS_PATH=/mes-cotisations

# --- Liens absolus (toutes les pages) ---
VITE_LOGIN_URL=https://preprod.votredomaine.ci/login
VITE_ADMIN_LOGIN_URL=https://preprod.votredomaine.ci/admin_connecte
VITE_REGISTER_URL=https://preprod.votredomaine.ci/register
VITE_ADMIN_URL=https://preprod.votredomaine.ci/admin
VITE_ADMIN_MEMBRES_URL=https://preprod.votredomaine.ci/admin/membres
VITE_ADMIN_COTISATIONS_URL=https://preprod.votredomaine.ci/admin/cotisations
VITE_ADMIN_BUREAU_URL=https://preprod.votredomaine.ci/admin/bureau
VITE_ADMIN_COMPTE_URL=https://preprod.votredomaine.ci/admin/compte
VITE_ADMIN_ACTIVITE_URL=https://preprod.votredomaine.ci/admin/activites
VITE_PROFIL_URL=https://preprod.votredomaine.ci/profil
VITE_MES_COTISATIONS_URL=https://preprod.votredomaine.ci/mes-cotisations
